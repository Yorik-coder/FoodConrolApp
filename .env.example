# --- App ---
# Порт приложения (контейнер слушает на SERVER_PORT, наружу пробрасывается APP_PORT)
SERVER_PORT=8080
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Postgres ---
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# ВАЖНО: задайте реальный пароль — Docker Compose подставит его в SPRING_DATASOURCE_PASSWORD
POSTGRES_PASSWORD=change_me

# Порт БД наружу (не обязателен, но полезен локально)
DB_PORT=5432
